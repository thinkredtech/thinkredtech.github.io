# =============================================================================
# ThinkRED Monorepo Environment Configuration
# =============================================================================
# This file contains all environment variables for the entire monorepo
# Copy this file to .env and fill in your actual values
# 
# SECURITY WARNING: Never commit .env files to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# GOOGLE APPS SCRIPT CONFIGURATION
# -----------------------------------------------------------------------------
# The Google Apps Script project ID (from script.google.com)
GOOGLE_APPS_SCRIPT_ID=your-google-apps-script-project-id

# The current deployment ID for the web app (changes with each deployment)
# This is the ID in the URL: https://script.google.com/macros/s/{DEPLOYMENT_ID}/exec
GOOGLE_APPS_SCRIPT_DEPLOYMENT_ID=your-current-deployment-id

# Base URL for Google Apps Script web app
GOOGLE_APPS_SCRIPT_BASE_URL=https://script.google.com/macros/s

# -----------------------------------------------------------------------------
# GOOGLE SHEETS CONFIGURATION
# -----------------------------------------------------------------------------
# Google Sheets ID for contact form submissions
CONTACT_FORM_SHEET_ID=your-contact-form-sheet-id

# Google Sheets ID for job application submissions
JOB_APPLICATION_SHEET_ID=your-job-application-sheet-id

# -----------------------------------------------------------------------------
# GOOGLE DRIVE CONFIGURATION
# -----------------------------------------------------------------------------
# Parent folder ID for storing resumes and cover letters
RESUME_PARENT_FOLDER_ID=your-resume-folder-id

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# -----------------------------------------------------------------------------
# Primary email address for notifications
EMAIL_TO=your-email@example.com

# CC email for contact form submissions
EMAIL_CC_CONTACT_FORM=contact-cc@example.com

# CC email for job application submissions
EMAIL_CC_JOB_APPLY=jobs-cc@example.com

# -----------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# -----------------------------------------------------------------------------
# Environment (development, staging, production)
NODE_ENV=development

# Admin Authentication
# Set this to enable admin functionality for job management
# SECURITY: Never commit the actual password to version control
REACT_APP_ADMIN_PASSWORD=<YOUR_SECURE_PASSWORD_HERE>

# Frontend build output directory
BUILD_OUTPUT_DIR=build

# Base URL for the frontend (for GitHub Pages or custom domain)
FRONTEND_BASE_URL=https://thinkredtech.github.io

# API endpoint timeout in milliseconds
API_TIMEOUT=30000

# Enable/disable form submission rate limiting
ENABLE_RATE_LIMITING=true

# Rate limit cooldown period in milliseconds
RATE_LIMIT_COOLDOWN=5000

# -----------------------------------------------------------------------------
# DEVELOPMENT CONFIGURATION
# -----------------------------------------------------------------------------
# Enable detailed logging in development
ENABLE_DEV_LOGGING=true

# Enable API debugging
ENABLE_API_DEBUG=true

# Local development server port
DEV_SERVER_PORT=3000

# -----------------------------------------------------------------------------
# DEPLOYMENT CONFIGURATION
# -----------------------------------------------------------------------------
# Deployment description for Google Apps Script
DEPLOYMENT_DESCRIPTION="Automated deployment from local development"

# Enable automatic deployment on push
AUTO_DEPLOY_ON_PUSH=false

# Deployment target (github-pages, hostinger, etc.)
DEPLOYMENT_TARGET=github-pages

# -----------------------------------------------------------------------------
# ANALYTICS & MONITORING
# -----------------------------------------------------------------------------
# Google Analytics tracking ID (optional)
GOOGLE_ANALYTICS_ID=

# Enable form submission analytics
ENABLE_FORM_ANALYTICS=true

# Enable error tracking
ENABLE_ERROR_TRACKING=true

# -----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# -----------------------------------------------------------------------------
# Enable honeypot spam protection
ENABLE_HONEYPOT=true

# Enable CSRF protection (for future use)
ENABLE_CSRF_PROTECTION=false

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=https://thinkredtech.github.io,http://localhost:3000

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
# Enable job applications feature
ENABLE_JOB_APPLICATIONS=true

# Enable contact form feature
ENABLE_CONTACT_FORM=true

# Enable blog feature
ENABLE_BLOG=true

# Enable portfolio feature
ENABLE_PORTFOLIO=true

# -----------------------------------------------------------------------------
# BUILD CONFIGURATION
# -----------------------------------------------------------------------------
# Enable source maps in production
ENABLE_PROD_SOURCE_MAPS=false

# Enable bundle analysis
ENABLE_BUNDLE_ANALYSIS=false

# Enable CSS minification
ENABLE_CSS_MINIFICATION=true

# Enable JavaScript minification
ENABLE_JS_MINIFICATION=true

# -----------------------------------------------------------------------------
# DEVELOPMENT NOTES
# -----------------------------------------------------------------------------
# 1. Copy this file to .env for local development
# 2. Set a strong password for REACT_APP_ADMIN_PASSWORD
# 3. Never commit .env to version control
# 4. In production, set environment variables through your hosting platform
# 5. Update GOOGLE_APPS_SCRIPT_DEPLOYMENT_ID after each backend deployment
