# dependencies
node_modules/
**/node_modules/
/.pnp
.pnp.js
package-lock.json

# testing
/coverage
**/coverage/

# production
build/
**/build/
hostinger-deploy/
**/hostinger-deploy/
thinkred-website.zip
**/thinkred-website.zip
# Keep dist/ for potential future use or other build tools
dist/
**/dist/

# misc
.DS_Store
**/.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Backup files created by deployment scripts
*.backup*
*.tmp
*.temp

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
.nyc_output

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Deployment configuration backups
.deployment-config.json.backup*

# Auto-generated reports (keep directory structure, ignore generated files)
# Note: Workflows may force-add specific reports using git add -f
reports/*.md
!reports/README.md
