# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
**/node_modules/
/.pnp
.pnp.js
package-lock.json

# testing
/coverage
**/coverage/

# production
build/
**/build/
hostinger-deploy/
**/hostinger-deploy/
thinkred-website.zip
**/thinkred-website.zip
# Keep dist/ for potential future use or other build tools
dist/
**/dist/

# Build artifacts and source maps
*.map
**/*.map
*.min.js
**/*.min.js
*.min.css
**/*.min.css
*.bundle.js
**/*.bundle.js
*.bundle.css
**/*.bundle.css

# Automated reports and status files (generated, not tracked)
**/automated/health-report.md
**/automated/status-dashboard.md
scripts/reports/automated/
reports/automated/*.md
reports/automated/
!reports/automated/.gitkeep
!reports/automated/templates/

# Vite build cache and temp files
.vite/
**/.vite/
vite.config.js.timestamp-*
**/vite.config.js.timestamp-*

# Build process temporary files
*.tsbuildinfo
**/*.tsbuildinfo
.turbo/
**/.turbo/
.next/
**/.next/
.nuxt/
**/.nuxt/
.output/
**/.output/
.vercel/
**/.vercel/
.netlify/
**/.netlify/

# Cache directories
.cache/
**/.cache/
.parcel-cache/
**/.parcel-cache/
.rollup.cache/
**/.rollup.cache/

# misc
.DS_Store
**/.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Security sensitive files
*.key
*.pem
*.p12
*.json.backup*
**/secrets.*
**/.secrets/
clasp-credentials.json
**/clasp-credentials.json

# Backup files created by deployment scripts
*.backup*
*.tmp
*.temp
*~
**/*~
*.lock.tmp
**/*.lock.tmp

# Build and deployment locks
*.building
**/*.building
*.deploying
**/*.deploying
deploy.lock
**/deploy.lock
build.lock
**/build.lock

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
.nyc_output

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Deployment configuration backups
.deployment-config.json.backup*

# Auto-generated reports (keep directory structure, ignore generated files)
# Note: Workflows may force-add specific reports using git add -f
reports/*.md
!reports/README.md
