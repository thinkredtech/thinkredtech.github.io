# Environment Variables Configuration
# Copy this file to .env.local and fill in the actual values
# DO NOT commit .env.local to version control

# Google Apps Script Configuration
VITE_GOOGLE_APPS_SCRIPT_DEPLOYMENT_ID=AKfycbyC3WXgrOpDZV1qG4xicgG26bbPvQLMPnvYvIt8ENU5QvOOmiGApN1l3R96pf78HdmJDQ

# Admin Configuration (for admin panel access)
VITE_ADMIN_PASSWORD=

# API Configuration
VITE_API_TIMEOUT=30000
VITE_ENABLE_API_DEBUG=false

# Feature Flags
VITE_ENABLE_JOB_APPLICATIONS=true
VITE_ENABLE_CONTACT_FORM=true
VITE_ENABLE_BLOG=true
VITE_ENABLE_PORTFOLIO=true

# Security Configuration
VITE_ENABLE_HONEYPOT=true
VITE_ENABLE_RATE_LIMITING=true
VITE_RATE_LIMIT_COOLDOWN=5000
VITE_ALLOWED_ORIGINS=https://thinkredtech.github.io,http://localhost:3000

# Analytics (optional)
VITE_GOOGLE_ANALYTICS_ID=

# Development Configuration
VITE_ENABLE_DEV_LOGGING=true
VITE_DEV_SERVER_PORT=3000

# Build Configuration
VITE_ENABLE_PROD_SOURCE_MAPS=false
VITE_ENABLE_BUNDLE_ANALYSIS=false
VITE_ENABLE_CSS_MINIFICATION=true
VITE_ENABLE_JS_MINIFICATION=true
