# ThinkRED Frontend Environment Configuration Template
# Copy this to .env.local and fill in your actual values

# ═══════════════════════════════════════════════════════════
# REQUIRED CONFIGURATION
# ═══════════════════════════════════════════════════════════

# Google Apps Script Configuration
VITE_GOOGLE_APPS_SCRIPT_ID=<YOUR_GOOGLE_APPS_SCRIPT_PROJECT_ID>
VITE_GOOGLE_APPS_SCRIPT_DEPLOYMENT_ID=<YOUR_DEPLOYMENT_ID>

# Admin Panel Configuration (SENSITIVE - KEEP SECRET)
VITE_REACT_APP_ADMIN_PASSWORD=<YOUR_SECURE_ADMIN_PASSWORD>

# ═══════════════════════════════════════════════════════════
# OPTIONAL CONFIGURATION
# ═══════════════════════════════════════════════════════════

# API Configuration
VITE_API_TIMEOUT=30000
VITE_ENABLE_API_DEBUG=false

# Feature Flags
VITE_ENABLE_JOB_APPLICATIONS=true
VITE_ENABLE_CONTACT_FORM=true
VITE_ENABLE_BLOG=true
VITE_ENABLE_PORTFOLIO=true

# Security Configuration
VITE_ENABLE_HONEYPOT=true
VITE_ENABLE_RATE_LIMITING=true
VITE_RATE_LIMIT_COOLDOWN=5000
VITE_ALLOWED_ORIGINS=https://thinkredtech.github.io,http://localhost:3000

# Analytics Configuration
VITE_GOOGLE_ANALYTICS_ID=<YOUR_GA_ID>
VITE_ENABLE_FORM_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true

# Development Configuration
VITE_ENABLE_DEV_LOGGING=true
VITE_DEV_SERVER_PORT=3000

# Build Configuration
VITE_ENABLE_PROD_SOURCE_MAPS=false
VITE_ENABLE_BUNDLE_ANALYSIS=false
VITE_ENABLE_CSS_MINIFICATION=true
VITE_ENABLE_JS_MINIFICATION=true

# Legacy support (for backward compatibility)
REACT_APP_ADMIN_PASSWORD=<YOUR_SECURE_ADMIN_PASSWORD>

# ═══════════════════════════════════════════════════════════
# SECURITY NOTES
# ═══════════════════════════════════════════════════════════
# 
# 1. Never commit this file with real values
# 2. Use strong passwords for admin access
# 3. Keep deployment IDs secure
# 4. Review allowed origins regularly
# 5. Rotate credentials periodically
