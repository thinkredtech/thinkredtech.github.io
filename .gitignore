# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
**/node_modules/
/.pnp
.pnp.js
# Package lock files should be committed for consistency
# package-lock.json is now tracked for dependency consistency

# testing
/coverage
**/coverage/

# production build outputs (generated by build process)
build/
**/build/
frontend/dist/
**/frontend/dist/
frontend/hostinger-deploy/
**/hostinger-deploy/
thinkred-website.zip
**/thinkred-website.zip

# Build artifacts and source maps
*.map
**/*.map
*.min.js
**/*.min.js
*.min.css
**/*.min.css
*.bundle.js
**/*.bundle.js
*.bundle.css
**/*.bundle.css

# Automated reports directory (generated content only)
reports/automated/
!reports/automated/.gitkeep
!reports/automated/README.md
!reports/automated/templates/

# Manual reports in incidents/, operational/, security/ should be tracked
# Only ignore reports that are clearly in the wrong location (root reports/ dir)

# Vite build cache and temp files
.vite/
**/.vite/
vite.config.js.timestamp-*
**/vite.config.js.timestamp-*

# Build process temporary files
*.tsbuildinfo
**/*.tsbuildinfo
.turbo/
**/.turbo/
.next/
**/.next/
.nuxt/
**/.nuxt/
.output/
**/.output/
.vercel/
**/.vercel/
.netlify/
**/.netlify/

# Cache directories
.cache/
**/.cache/
.parcel-cache/
**/.parcel-cache/
.rollup.cache/
**/.rollup.cache/

# misc
.DS_Store
**/.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Security sensitive files
*.key
*.pem
*.p12
*.json.backup*
**/secrets.*
**/.secrets/
clasp-credentials.json
**/clasp-credentials.json

# Backup files created by deployment scripts
*.backup*
*.tmp
*.temp
*~
**/*~
*.lock.tmp
**/*.lock.tmp

# Build and deployment locks
*.building
**/*.building
*.deploying
**/*.deploying
deploy.lock
**/deploy.lock
build.lock
**/build.lock

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
.nyc_output

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Deployment configuration backups
.deployment-config.json.backup*
