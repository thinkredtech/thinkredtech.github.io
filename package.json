{
  "name": "thinkred-monorepo",
  "version": "1.0.0",
  "description": "ThinkRED monorepo containing frontend React app and Google Apps Script backend",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "cd frontend && npm run dev",
    "dev": "npm start",
    "build": "cd frontend && npm run build && cp -r build ../",
    "clean": "npm run clean:frontend && npm run clean:backend",
    "clean:frontend": "cd frontend && npm run clean",
    "clean:backend": "rm -rf backend/node_modules backend/.clasp.json.bak",
    "test": "cd frontend && npm run test",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && npm run lint || echo 'Backend linting not configured'",
    "format": "cd frontend && npm run format:all",
    "format:check": "cd frontend && npm run format:check",
    "type-check": "cd frontend && npm run type-check",
    "install:all": "npm run install:frontend && npm run install:backend",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && npm install",
    "deploy": "node scripts/deploy.js",
    "release": "npm run deploy"
  },
  "devDependencies": {
    "semver": "^7.5.4",
    "chalk": "^4.1.2",
    "inquirer": "^8.2.6",
    "shelljs": "^0.8.5",
    "@google/clasp": "^2.4.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thinkredtech/thinkred-monorepo.git"
  },
  "keywords": [
    "thinkred",
    "monorepo",
    "react",
    "google-apps-script",
    "frontend",
    "backend"
  ],
  "author": "ThinkRED Tech",
  "license": "MIT"
}
