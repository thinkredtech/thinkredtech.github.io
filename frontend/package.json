{
  "name": "@thinkred/frontend",
  "homepage": "https://thinkredtech.github.io",
  "version": "1.0.7",
  "private": true,
  "type": "module",
  "dependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "glob": "^11.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build && cp -r docs dist/docs",
    "clean": "rm -rf dist .vite",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -b gh-pages",
    "deploy:github": "npm run build && gh-pages -d dist -b gh-pages",
    "deploy:hostinger": "../scripts/deploy/deploy-hostinger.sh",
    "deploy:ssh": "../scripts/deploy/deploy-ssh.sh",
    "debug:github-pages": "../scripts/dev/debug-github-pages.sh",
    "security:validate": "node ../scripts/utils/validate-security.cjs",
    "security:scan": "node ../scripts/utils/scan-sensitive-data.cjs",
    "security:build": "../scripts/deploy/deploy-production.sh",
    "reports:generate": "node ../scripts/utils/generate-visual-reports.cjs",
    "reports:health": "node ../scripts/utils/generate-visual-reports.cjs && echo 'Health report updated!'",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"!node_modules\" \"!build\"",
    "lint:md:fix": "node scripts/fix-markdown-lint.cjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css}\"",
    "format:md": "prettier --write \"**/*.md\" --ignore-path .gitignore",
    "format:all": "npm run format && npm run format:md && npm run lint:md:fix",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css}\"",
    "type-check": "tsc --noEmit",
    "test": "echo \"No tests specified. Please add tests to improve code coverage.\" && exit 0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "gh-pages": "^6.3.0",
    "markdownlint-cli2": "^0.18.1",
    "postcss": "^8.4.31",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.3.0",
    "terser": "^5.43.1",
    "vite": "^6.3.5"
  },
  "overrides": {
    "postcss": "^8.4.31",
    "nth-check": "^2.1.1",
    "svgo": "^3.0.2"
  }
}
